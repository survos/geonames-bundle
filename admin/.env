GEONAMES_ENDPOINT="https://download.geonames.org/export/dump/"
# GEONAMES_OUTPUT_DIR points at the SAME directory GeoService reads at runtime on this machine:
# /platform -> /media/tac/x10a/v2 (APP_DATA_DIR in md/openfoto's .env), and GeoService::sqliteDir()
# falls back to APP_SHARED_DIRECTORY/geonames-data. Building here means `admin build` writes
# straight into the live shared cache apps already query, no separate copy step.
GEONAMES_SOURCE_DIR="/media/tac/x10a/v2/geonames-source"
GEONAMES_OUTPUT_DIR="/media/tac/x10a/v2/geonames-data"
HF_ACCOUNT="museado"
